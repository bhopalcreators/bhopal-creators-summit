# Server
PORT=5000
NODE_ENV=development

# MongoDB — get this from MongoDB Atlas (free tier is fine to start)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bhopal-creators-summit
MONGODB_URI=mongodb://localhost:27017/bhopal-creators-summit

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
